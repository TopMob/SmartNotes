rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasLegacyAccessMap(noteData) {
      return noteData.access is map
        && noteData.access.ownerUid is string
        && noteData.access.allow is list;
    }

    function hasRoleMapAccess(noteData) {
      return noteData.access is map
        && noteData.access.ownerUid is string
        && noteData.access.roles is map;
    }

    function canReadByLegacyAccess(noteData, ownerId) {
      return hasLegacyAccessMap(noteData)
        && noteData.access.ownerUid == ownerId
        && isAuthenticated()
        && request.auth.uid in noteData.access.allow;
    }

    function canReadByRoleMap(noteData, ownerId) {
      return hasRoleMapAccess(noteData)
        && noteData.access.ownerUid == ownerId
        && isAuthenticated()
        && request.auth.uid in noteData.access.roles;
    }

    function canEditByLegacyAccess(noteData, ownerId) {
      return canReadByLegacyAccess(noteData, ownerId)
        && noteData.access.role == 'editor';
    }

    function canEditByRoleMap(noteData, ownerId) {
      return canReadByRoleMap(noteData, ownerId)
        && noteData.access.roles[request.auth.uid] in ['editor', 'owner'];
    }

    function canDeleteByLegacyAccess(noteData, ownerId) {
      return canReadByLegacyAccess(noteData, ownerId)
        && noteData.access.role == 'owner';
    }

    function canDeleteByRoleMap(noteData, ownerId) {
      return canReadByRoleMap(noteData, ownerId)
        && noteData.access.roles[request.auth.uid] == 'owner';
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /notes/{noteId} {
        allow read: if isOwner(userId)
          || canReadByLegacyAccess(resource.data, userId)
          || canReadByRoleMap(resource.data, userId);

        allow create: if isOwner(userId)
          && request.resource.data.ownerId == request.auth.uid;

        allow update: if isOwner(userId)
          || canEditByLegacyAccess(resource.data, userId)
          || canEditByRoleMap(resource.data, userId);

        allow delete: if isOwner(userId)
          || canDeleteByLegacyAccess(resource.data, userId)
          || canDeleteByRoleMap(resource.data, userId);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /sharedNotes/{entryId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /noteShares/{token} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.noteId is string
        && request.resource.data.permission in ['viewer', 'editor'];

      allow read: if isAuthenticated();
      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /feedback/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
