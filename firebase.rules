rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasAccessRoles(noteData) {
      return noteData.access is map
        && noteData.access.ownerUid is string
        && noteData.access.roles is map;
    }

    function requesterRole(noteData) {
      return noteData.access.roles[request.auth.uid];
    }

    function canReadShared(noteData, ownerId) {
      return isAuthenticated()
        && hasAccessRoles(noteData)
        && noteData.access.ownerUid == ownerId
        && request.auth.uid in noteData.access.roles;
    }

    function canEditShared(noteData, ownerId) {
      return canReadShared(noteData, ownerId)
        && requesterRole(noteData) in ['editor', 'owner'];
    }

    function canDeleteShared(noteData, ownerId) {
      return canReadShared(noteData, ownerId)
        && requesterRole(noteData) == 'owner';
    }

    function isValidOwnerPayload(ownerId) {
      return request.resource.data.ownerUid == ownerId
        && request.resource.data.access is map
        && request.resource.data.access.ownerUid == ownerId
        && request.resource.data.access.roles[ownerId] == 'owner';
    }

    function workspaceDocument(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function isWorkspaceOwner(workspaceId) {
      return isAuthenticated()
        && workspaceExists(workspaceId)
        && workspaceDocument(workspaceId).ownerUid == request.auth.uid;
    }

    function hasWorkspaceEntry(workspaceId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedWorkspaces/$(workspaceId));
    }

    function workspaceEntry(workspaceId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/sharedWorkspaces/$(workspaceId)).data;
    }

    function workspaceEntryRole(workspaceId) {
      return workspaceEntry(workspaceId).role;
    }

    function canReadWorkspace(workspaceId) {
      return hasWorkspaceEntry(workspaceId);
    }

    function canEditWorkspace(workspaceId) {
      return hasWorkspaceEntry(workspaceId)
        && workspaceEntryRole(workspaceId) in ['owner', 'editor'];
    }

    function canManageWorkspace(workspaceId) {
      return isWorkspaceOwner(workspaceId)
        || (
          hasWorkspaceEntry(workspaceId)
          && workspaceEntryRole(workspaceId) == 'owner'
        );
    }

    function isValidThemePreferencePayload() {
      return request.resource.data.settings is map
        && request.resource.data.settings.preset is string
        && request.resource.data.settings.p is string
        && request.resource.data.settings.bg is string
        && request.resource.data.settings.t is string
        && request.resource.data.settings.mainBackgroundImage is string
        && request.resource.data.settings.mainBackgroundImage.size() <= 2048
        && request.resource.data.settings.sidebarBackgroundImage is string
        && request.resource.data.settings.sidebarBackgroundImage.size() <= 2048
        && request.resource.data.settings.uiOpacity is number
        && request.resource.data.settings.cardsOpacity is number
        && (
          !('customPresets' in request.resource.data)
          || request.resource.data.customPresets is list
        );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /notes/{noteId} {
        allow read: if isOwner(userId)
          || canReadShared(resource.data, userId);

        allow create: if isOwner(userId)
          && hasAccessRoles(request.resource.data)
          && isValidOwnerPayload(userId);

        allow update: if isOwner(userId)
          || (
            canEditShared(resource.data, userId)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.access == resource.data.access
          );

        allow delete: if isOwner(userId)
          || canDeleteShared(resource.data, userId);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /preferences/{preferenceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (preferenceId != 'theme' || isValidThemePreferencePayload());
        allow delete: if isOwner(userId);
      }

      match /sharedNotes/{entryId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }

      match /sharedWorkspaces/{workspaceId} {
        allow read: if isOwner(userId);

        allow create, update: if (
            isOwner(userId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.ownerUid is string
            && request.resource.data.role in ['owner', 'editor', 'viewer']
          )
          || (
            isWorkspaceOwner(workspaceId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.role in ['owner', 'editor', 'viewer']
          );

        allow delete: if isOwner(userId) || isWorkspaceOwner(workspaceId);
      }
    }

    match /noteShares/{token} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.noteId is string
        && request.resource.data.permission in ['viewer', 'editor'];

      allow read: if isAuthenticated();
      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /workspaceShares/{token} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceName is string
        && request.resource.data.role in ['viewer', 'editor']
        && workspaceExists(request.resource.data.workspaceId)
        && workspaceDocument(request.resource.data.workspaceId).ownerUid == request.auth.uid;

      allow read: if isAuthenticated();
      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      allow read: if canReadWorkspace(workspaceId) || isWorkspaceOwner(workspaceId);

      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner';

      allow update: if canManageWorkspace(workspaceId);
      allow delete: if canManageWorkspace(workspaceId);

      match /notes/{noteId} {
        allow read: if canReadWorkspace(workspaceId) || isWorkspaceOwner(workspaceId);

        allow create: if canEditWorkspace(workspaceId)
          && request.resource.data.workspaceId == workspaceId;

        allow update: if canEditWorkspace(workspaceId)
          && request.resource.data.workspaceId == workspaceId;

        allow delete: if canEditWorkspace(workspaceId);
      }
    }

    match /feedback/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
